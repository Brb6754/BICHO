# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key — server-only, NEVER expose to the client or prefix
# with NEXT_PUBLIC_. Bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The apex domain tenants live under, e.g. "tuapp.com" in production or
# "localhost:3000" in development. Tenant subdomains resolve as
# {slug}.NEXT_PUBLIC_ROOT_DOMAIN — see proxy.ts.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Resend API key — booking confirmation emails
# (lib/email/sendBookingConfirmation.ts). Without this set, booking
# confirmation emails are silently skipped (bookings themselves still
# work). Get one at https://resend.com/api-keys.
RESEND_API_KEY=your-resend-api-key

# Dominio verificado en Resend. Con esto puesto los correos salen de
# reservas@ y ventas@ de ese dominio; sin esto, del dominio compartido
# de Resend (onboarding@resend.dev). NO lo prendas antes de que Resend
# marque el dominio como Verified: envía desde un dominio sin verificar
# y Resend rechaza el envío.
EMAIL_DOMAIN=bichomx.com

# Where the "nueva solicitud de demo" notification goes
# (lib/email/sendDemoRequestNotice.ts). Optional: defaults to the address
# shown on the landing page. Needs RESEND_API_KEY above to do anything —
# without it the lead is still saved in `demo_requests`, just not emailed.
DEMO_NOTIFY_EMAIL=tu-correo@ejemplo.com

# A dónde llega el aviso "alta nueva" de cada negocio que se registra
# solo en /registro (lib/email/registro.ts). Opcional: sin ella usa
# DEMO_NOTIFY_EMAIL. Necesita RESEND_API_KEY; si el correo falla, el
# alta sigue (solo queda en el log).
ADMIN_NOTIFY_EMAIL=tu-correo@ejemplo.com

# ── WhatsApp (extra por negocio) ─────────────────────────────────────
# Sin estas variables el extra simplemente no manda nada: cada intento
# queda registrado como "skipped" en whatsapp_messages con el motivo, y
# la reserva funciona igual. Ver WHATSAPP_SETUP.md.
#
# WhatsApp Manager → API Setup. El token permanente es de un System User,
# no el temporal de 24 h que muestra la primera pantalla.
WHATSAPP_ACCESS_TOKEN=tu-token-permanente
# El ID del número emisor, NO el número de teléfono.
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Nombres EXACTOS de las plantillas aprobadas en Meta. El orden de los
# parámetros está documentado en WHATSAPP_SETUP.md.
WHATSAPP_TEMPLATE_CONFIRMATION=cita_confirmada
# Opcionales, para cuando existan esas plantillas:
# WHATSAPP_TEMPLATE_REMINDER=cita_recordatorio
# WHATSAPP_TEMPLATE_RESCHEDULED=cita_reprogramada
# WHATSAPP_TEMPLATE_CANCELLED=cita_cancelada
WHATSAPP_TEMPLATE_LANG=es_MX

# ── Stripe (test mode) ───────────────────────────────────────────────
# Rule 8: only test-mode keys ever live in this file. The live keys
# (sk_live_… / pk_live_… and a NEW whsec_ for the live endpoint) go in
# Vercel's secret store, never here — see PAGOKIT_PRODUCTION_CHECKLIST.md.
#
# Dashboard → Developers → API keys, with the Test mode switch ON.
# Server-only. Rule 1: never inline this value in source.
STRIPE_SECRET_KEY=sk_test_your-stripe-test-secret-key

# The only Stripe value the browser is allowed to see (Stripe Elements
# needs it to tokenize the card). Publishable by design — it cannot move
# money on its own.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-test-publishable-key

# Dashboard → Developers → Webhooks → your endpoint → "Signing secret".
# This is NOT the API key: verifying with STRIPE_SECRET_KEY fails
# silently and every event looks forged. Each endpoint you create gets
# its own secret, so the live one will differ from this one.
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-test-webhook-signing-secret

# ── Copiloto del negocio (lib/copiloto/) ─────────────────────────────
# Conexión DIRECTA a Postgres: la frontera necesita `set local role` y
# `set_config` dentro de una transacción, cosa que supabase-js no
# permite. Supabase → Project Settings → Database → Connection string →
# "Session pooler" (puerto 5432). Server-only; nunca NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.your-project:your-db-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Llave de la API de Anthropic para el agente. Server-only.
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Mercado Pago: plan mensual de cada negocio (db/044) ─────────────
# Tus integraciones → tu app → Credenciales de PRUEBA → Access Token
# (empieza con TEST-). Server-only; nunca NEXT_PUBLIC_.
MP_ACCESS_TOKEN=
# Tus integraciones → tu app → Webhooks → "Clave secreta" de la firma.
# NO es el access token. La de producción es distinta a la de prueba.
MP_WEBHOOK_SECRET=
# Opcional. Base https para la back_url del checkout (MP no acepta
# http://localhost). Si falta se usa NEXT_PUBLIC_ROOT_DOMAIN.
MP_BACK_URL_BASE=
